# Copia questo file in .env e inserisci i valori del tuo progetto Supabase
# (Dashboard Supabase → Settings → API). Il file .env NON va mai committato.
#
# NOTA: qui vive solo la anon key PUBBLICA. La chiave API Anthropic e la
# service role key stanno SOLO nelle env delle Edge Functions (supabase secrets).
EXPO_PUBLIC_SUPABASE_URL=https://tuo-progetto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=la-tua-anon-key
